# ============================================
# LUMIN PUBLISHING - Environment Variables
# Copy to .env and fill in real values
# ============================================

# === REQUIRED (must set these) ===

# PostgreSQL Database
# Get a free one at: neon.tech or supabase.com
DATABASE_URL="postgresql://user:password@host:5432/lumin"

# JWT Secret (random 32+ char string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-random-string-min-32-chars"

# Public site URL (changes for production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cron Secret (protect /api/cron from random calls)
# Generate a random string. Vercel cron passes this automatically.
CRON_SECRET="another-random-string-for-cron-auth"


# === AI PROVIDER (choose one or both) ===

# Which AI to use as primary brain. Options: "anthropic" or "openai"
AI_PROVIDER="anthropic"

# Anthropic Claude (recommended for writing quality)
# Get from: console.anthropic.com
ANTHROPIC_API_KEY=""

# OpenAI GPT (cheaper, faster)
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY=""


# === IMAGE GENERATION (for book covers) ===

# Stability AI (best for book covers)
# Get from: platform.stability.ai
STABILITY_API_KEY=""

# OR Replicate (cheaper alternative)
# Get from: replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""


# === EMAIL SENDING (for Mailer Bot) ===

# Resend (easiest, free 3000 emails/month)
# Get from: resend.com
RESEND_API_KEY=""

# Sender email (must be verified in Resend dashboard)
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# OR SendGrid (alternative)
SENDGRID_API_KEY=""


# === PAYMENTS ===

# Razorpay for India (₹)
# Get from: dashboard.razorpay.com
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Stripe for global ($)
# Get from: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""


# === FILE STORAGE ===

# AWS S3 for manuscript and cover uploads
# Get from: aws.amazon.com/console
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"

# OR Cloudflare R2 (cheaper, S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""


# === DISTRIBUTION (optional, for auto-publishing to retailers) ===

# Amazon KDP API (when available)
KDP_API_KEY=""

# Apple Books
APPLE_BOOKS_API_KEY=""

# Google Play Books Partner
GOOGLE_PLAY_BOOKS_API_KEY=""


# === MONITORING (production) ===

# Sentry for error tracking
SENTRY_DSN=""

# Better Stack for uptime monitoring
BETTERSTACK_API_KEY=""


# === ADMIN NOTIFICATIONS ===

# Where to send admin alerts (your email)
ADMIN_EMAIL="harsh@yourdomain.com"

# Push notifications (optional)
PUSHOVER_USER_KEY=""
PUSHOVER_API_TOKEN=""
